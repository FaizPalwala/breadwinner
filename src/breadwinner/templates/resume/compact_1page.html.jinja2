<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ profile.full_name }} - Resume</title>
  <style>
    @page {
      size: A4;
      margin: 8mm 12mm 8mm 12mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      font-size: 9.2pt;
      line-height: 1.28;
      color: #111111;
      background: #ffffff;
    }
    .container {
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
    }
    /* Compact Header */
    .header {
      text-align: center;
      margin-bottom: 5pt;
    }
    .header h1 {
      font-size: 16pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      line-height: 1.1;
      margin-bottom: 2pt;
    }
    .header-subline {
      font-size: 9.2pt;
      font-weight: 600;
      color: #2563eb;
      margin-bottom: 2pt;
    }
    .contact-line {
      font-size: 8.5pt;
      color: #444444;
    }
    .contact-line a {
      color: #111111;
      text-decoration: none;
    }
    /* Section Headings */
    .section-title {
      font-size: 9.8pt;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1.5px solid #111111;
      padding-bottom: 0.5pt;
      margin-top: 5pt;
      margin-bottom: 3pt;
    }
    /* Entry Rows */
    .entry {
      margin-bottom: 4pt;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 9.2pt;
    }
    .entry-title {
      font-weight: 700;
    }
    .entry-subtitle {
      font-weight: 600;
      color: #333333;
    }
    .entry-date {
      font-size: 8.5pt;
      color: #555555;
    }
    /* Bullets */
    ul {
      margin-left: 12pt;
      margin-top: 1pt;
      margin-bottom: 2pt;
    }
    li {
      margin-bottom: 1pt;
      font-size: 8.8pt;
      text-align: justify;
    }
    li strong {
      font-weight: 700;
    }
    /* Skills */
    .skills-row {
      font-size: 8.8pt;
      margin-bottom: 1pt;
    }
    @media print {
      body { width: 100%; }
      .no-print { display: none; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <h1>{{ profile.full_name }}</h1>
      <div class="header-subline">{{ profile.title }}</div>
      <div class="contact-line">
        {% set items = [] %}
        {% if profile.location %}{% set _ = items.append(profile.location) %}{% endif %}
        {% if profile.email %}{% set _ = items.append('<a href="mailto:' ~ profile.email ~ '">' ~ profile.email ~ '</a>') %}{% endif %}
        {% if profile.phone %}{% set _ = items.append(profile.phone) %}{% endif %}
        {% if profile.linkedin_url %}{% set _ = items.append('<a href="' ~ profile.linkedin_url ~ '">LinkedIn</a>') %}{% endif %}
        {% if profile.github_url %}{% set _ = items.append('<a href="' ~ profile.github_url ~ '">GitHub</a>') %}{% endif %}
        {{ items | join(' | ') }}
      </div>
    </header>

    <!-- Education (Front-Loaded for Early Career) -->
    {% if profile.education %}
    <section>
      <div class="section-title">Education</div>
      {% for edu in profile.education %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ edu.institution }}</span>
          <span class="entry-date">{% if edu.start_date and edu.end_date %}{{ edu.start_date }} - {{ edu.end_date }}{% elif edu.end_date %}{{ edu.end_date }}{% endif %}</span>
        </div>
        <div class="entry-header">
          <span class="entry-subtitle">{{ edu.degree }}{% if edu.field_of_study %} in {{ edu.field_of_study }}{% endif %}</span>
          {% if edu.grade %}<span style="font-size: 8.5pt; font-weight: 600;">Grade: {{ edu.grade }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Technical Skills -->
    {% if profile.skills %}
    <section>
      <div class="section-title">Technical Skills</div>
      {% for sk in profile.skills %}
      <div class="skills-row">
        <strong>{{ sk.category }}:</strong> {{ sk.skills | join(', ') }}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Experience -->
    {% if app.tailored_experiences %}
    <section>
      <div class="section-title">Experience</div>
      {% for exp in app.tailored_experiences %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ exp.role }}</span>
          <span class="entry-date">{{ exp.start_date }} - {{ exp.end_date }}</span>
        </div>
        <div class="entry-header">
          <span class="entry-subtitle">{{ exp.company }}</span>
          {% if exp.location %}<span style="font-size: 8.5pt; color: #555;">{{ exp.location }}</span>{% endif %}
        </div>
        {% if exp.bullets %}
        <ul>
          {% for bullet in exp.bullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Projects -->
    {% if app.tailored_projects %}
    <section>
      <div class="section-title">Projects</div>
      {% for proj in app.tailored_projects %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ proj.name }} {% if proj.tech_stack %}| <em style="font-size: 8.5pt; color: #444;">{{ proj.tech_stack | join(', ') }}</em>{% endif %}</span>
          {% if proj.github_url %}<span class="entry-date"><a href="{{ proj.github_url }}">Link</a></span>{% endif %}
        </div>
        {% if proj.highlights %}
        <ul>
          {% for hl in proj.highlights %}
          <li>{{ hl }}</li>
          {% endfor %}
        </ul>
        {% elif proj.description %}
        <div style="font-size: 8.8pt; margin-left: 12pt;">{{ proj.description }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

  </div>
</body>
</html>
