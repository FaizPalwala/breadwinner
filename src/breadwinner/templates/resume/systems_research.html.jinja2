<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ profile.full_name }} - Systems & Research Resume</title>
  <style>
    @page {
      size: A4;
      margin: 11mm 14mm 11mm 14mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace, sans-serif;
      font-size: 9.8pt;
      line-height: 1.34;
      color: #0f172a;
      background: #ffffff;
    }
    .container {
      width: 100%;
      max-width: 820px;
      margin: 0 auto;
    }
    /* Monospace Research Header */
    .header {
      border-bottom: 2px solid #0284c7;
      padding-bottom: 6pt;
      margin-bottom: 6pt;
    }
    .header h1 {
      font-size: 18pt;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.3px;
    }
    .header-subline {
      font-size: 10pt;
      font-weight: 600;
      color: #0284c7;
      margin-top: 2pt;
      margin-bottom: 3pt;
    }
    .meta-line {
      font-size: 8.8pt;
      color: #475569;
      display: flex;
      flex-wrap: wrap;
      gap: 8pt;
    }
    .meta-line a {
      color: #0369a1;
      text-decoration: none;
      font-weight: 600;
    }
    /* Section Headings */
    .section-title {
      font-size: 10.2pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #0369a1;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 1.5pt;
      margin-top: 7pt;
      margin-bottom: 4pt;
    }
    /* Research Summary */
    .research-summary {
      font-size: 9.4pt;
      color: #334155;
      line-height: 1.38;
      margin-bottom: 4pt;
      text-align: justify;
    }
    /* Entry Row */
    .entry {
      margin-bottom: 6pt;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 10pt;
    }
    .entry-title {
      font-weight: 700;
      color: #0f172a;
    }
    .entry-venue {
      font-weight: 600;
      color: #0284c7;
      font-size: 9.2pt;
    }
    .entry-date {
      font-size: 8.8pt;
      color: #64748b;
    }
    /* Bullets */
    ul {
      margin-left: 13pt;
      margin-top: 2pt;
      margin-bottom: 3pt;
    }
    li {
      margin-bottom: 1.5pt;
      font-size: 9.3pt;
      color: #1e293b;
      text-align: justify;
    }
    li strong {
      color: #0f172a;
      font-weight: 700;
    }
    /* Tech Stack Tags */
    .tech-pill {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 8.4pt;
      background: #f1f5f9;
      color: #334155;
      padding: 0 4pt;
      border-radius: 2pt;
      border: 1px solid #e2e8f0;
    }
    @media print {
      body { width: 100%; }
      .no-print { display: none; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <h1>{{ profile.full_name }}</h1>
      <div class="header-subline">{{ profile.title }}</div>
      <div class="meta-line">
        {% if profile.location %}<span>{{ profile.location }}</span>{% endif %}
        {% if profile.email %}<a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}
        {% if profile.github_url %}<a href="{{ profile.github_url }}">GitHub</a>{% endif %}
        {% if profile.portfolio_url %}<a href="{{ profile.portfolio_url }}">Research Hub</a>{% endif %}
        {% if profile.linkedin_url %}<a href="{{ profile.linkedin_url }}">LinkedIn</a>{% endif %}
      </div>
    </header>

    <!-- Research Focus -->
    {% if app.tailored_summary or profile.summary %}
    <section>
      <div class="section-title">Research Focus & System Architectures</div>
      <p class="research-summary">{{ app.tailored_summary or profile.summary }}</p>
    </section>
    {% endif %}

    <!-- Research & Benchmarks (Projects / Dissertations) -->
    {% if app.tailored_projects %}
    <section>
      <div class="section-title">Research Benchmarks & Open Frameworks</div>
      {% for proj in app.tailored_projects %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ proj.name }}</span>
          {% if proj.github_url or proj.url %}<span class="entry-date"><a href="{{ proj.github_url or proj.url }}" style="color: #0284c7; text-decoration: none;">Artifact / Repo</a></span>{% endif %}
        </div>
        {% if proj.tech_stack %}
        <div style="margin-top: 1pt; margin-bottom: 2pt;">
          {% for t in proj.tech_stack %}<span class="tech-pill">{{ t }}</span> {% endfor %}
        </div>
        {% endif %}
        {% if proj.highlights %}
        <ul>
          {% for hl in proj.highlights %}
          <li>{{ hl }}</li>
          {% endfor %}
        </ul>
        {% elif proj.description %}
        <p class="research-summary" style="margin-left: 13pt;">{{ proj.description }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Applied Engineering & Industry Experience -->
    {% if app.tailored_experiences %}
    <section>
      <div class="section-title">Applied Systems & Industry Experience</div>
      {% for exp in app.tailored_experiences %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ exp.role }} <span style="font-weight: 500; color: #475569;">at</span> <span class="entry-venue">{{ exp.company }}</span></span>
          <span class="entry-date">{{ exp.start_date }} - {{ exp.end_date }}</span>
        </div>
        {% if exp.bullets %}
        <ul>
          {% for bullet in exp.bullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Technical Stacks & Kernels -->
    {% if profile.skills %}
    <section>
      <div class="section-title">Frameworks, Runtimes & Languages</div>
      {% for sk in profile.skills %}
      <div style="font-size: 9.3pt; margin-bottom: 2pt;">
        <strong style="color: #0f172a;">{{ sk.category }}:</strong> {{ sk.skills | join(', ') }}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Academic Background -->
    {% if profile.education %}
    <section>
      <div class="section-title">Academic Credentials</div>
      {% for edu in profile.education %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ edu.institution }}</span>
          <span class="entry-date">{% if edu.start_date and edu.end_date %}{{ edu.start_date }} - {{ edu.end_date }}{% elif edu.end_date %}{{ edu.end_date }}{% endif %}</span>
        </div>
        <div class="entry-header">
          <span style="color: #334155; font-size: 9.4pt;">{{ edu.degree }}{% if edu.field_of_study %} in {{ edu.field_of_study }}{% endif %}</span>
          {% if edu.grade %}<span style="font-size: 8.8pt; color: #0284c7; font-weight: 600;">{{ edu.grade }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </section>
    {% endif %}

  </div>
</body>
</html>
