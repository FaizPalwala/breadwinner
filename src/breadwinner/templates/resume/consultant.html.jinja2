<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ profile.full_name }} - Technical Consultant & Fractional Lead</title>
  <style>
    @page {
      size: A4;
      margin: 11mm 14mm 11mm 14mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 9.8pt;
      line-height: 1.34;
      color: #1e293b;
      background: #ffffff;
    }
    .container {
      width: 100%;
      max-width: 820px;
      margin: 0 auto;
    }
    /* Consultant Header */
    .header {
      border-bottom: 2.5px solid #1e3a8a;
      padding-bottom: 7pt;
      margin-bottom: 7pt;
    }
    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 2pt;
    }
    .header h1 {
      font-size: 20pt;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.4px;
    }
    .header-location {
      font-size: 9pt;
      font-weight: 600;
      color: #64748b;
    }
    .header-title {
      font-size: 10.5pt;
      font-weight: 700;
      color: #1e3a8a;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 4pt;
    }
    .contact-bar {
      font-size: 8.8pt;
      color: #475569;
      display: flex;
      flex-wrap: wrap;
      gap: 10pt;
    }
    .contact-bar a {
      color: #1e3a8a;
      text-decoration: none;
      font-weight: 600;
    }
    /* Section Headings */
    .section-title {
      font-size: 10pt;
      font-weight: 800;
      color: #0f172a;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      border-bottom: 1px solid #cbd5e1;
      padding-bottom: 1.5pt;
      margin-top: 7pt;
      margin-bottom: 4pt;
    }
    /* Value Proposition / Summary */
    .value-prop {
      font-size: 9.4pt;
      color: #334155;
      line-height: 1.4;
      margin-bottom: 4pt;
      text-align: justify;
    }
    /* Client Engagements & ROI */
    .entry {
      margin-bottom: 6pt;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 9.8pt;
    }
    .role-title {
      font-weight: 700;
      color: #0f172a;
    }
    .client-firm {
      font-weight: 600;
      color: #1e3a8a;
      font-size: 9.4pt;
    }
    .entry-date, .entry-loc {
      font-size: 8.8pt;
      color: #64748b;
      font-weight: 500;
    }
    /* Bullets */
    ul {
      margin-left: 13pt;
      margin-top: 1.5pt;
      margin-bottom: 2pt;
    }
    li {
      margin-bottom: 1.5pt;
      font-size: 9.2pt;
      color: #1e293b;
      text-align: justify;
    }
    li strong {
      color: #0f172a;
      font-weight: 700;
    }
    /* Technical Architecture & Core Stacks */
    .stack-grid {
      margin-bottom: 4pt;
    }
    .stack-row {
      font-size: 9.2pt;
      margin-bottom: 1.5pt;
      color: #334155;
    }
    .stack-row strong {
      color: #0f172a;
      font-weight: 700;
    }
    @media print {
      body { width: 100%; }
      .no-print { display: none; }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <div class="header-row">
        <h1>{{ profile.full_name }}</h1>
        {% if profile.location %}<div class="header-location">{{ profile.location }}</div>{% endif %}
      </div>
      <div class="header-title">{{ profile.title or "Technical Consultant & Fractional Architecture Lead" }}</div>
      <div class="contact-bar">
        {% if profile.email %}<a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}
        {% if profile.phone %}<span>{{ profile.phone }}</span>{% endif %}
        {% if profile.linkedin_url %}<a href="{{ profile.linkedin_url }}">LinkedIn</a>{% endif %}
        {% if profile.github_url %}<a href="{{ profile.github_url }}">GitHub</a>{% endif %}
        {% if profile.portfolio_url %}<a href="{{ profile.portfolio_url }}">Portfolio</a>{% endif %}
      </div>
    </header>

    <!-- Value Proposition -->
    {% if app.tailored_summary or profile.summary %}
    <section>
      <div class="section-title">Strategic Value Proposition</div>
      <p class="value-prop">{{ app.tailored_summary or profile.summary }}</p>
    </section>
    {% endif %}

    <!-- Client Engagements & Commercial ROI -->
    {% if app.tailored_experiences %}
    <section>
      <div class="section-title">Client Engagements & Commercial ROI</div>
      {% for exp in app.tailored_experiences %}
      <div class="entry">
        <div class="entry-header">
          <span class="role-title">{{ exp.role }}</span>
          <span class="entry-date">{{ exp.start_date }} - {{ exp.end_date }}</span>
        </div>
        <div class="entry-header" style="margin-bottom: 1.5pt;">
          <span class="client-firm">{{ exp.company }}</span>
          {% if exp.location %}<span class="entry-loc">{{ exp.location }}</span>{% endif %}
        </div>
        {% if exp.bullets %}
        <ul>
          {% for bullet in exp.bullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Technical Architecture & Core Stacks -->
    {% if profile.skills %}
    <section class="stack-grid">
      <div class="section-title">Technical Architecture & Core Advisory Stacks</div>
      {% for sk in profile.skills %}
      <div class="stack-row">
        <strong>{{ sk.category }}:</strong> {{ sk.skills | join(', ') }}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Flagship Deliverables & Proofs of Concept -->
    {% if app.tailored_projects %}
    <section>
      <div class="section-title">Flagship Deliverables & Systems Architecture</div>
      {% for proj in app.tailored_projects %}
      <div class="entry">
        <div class="entry-header">
          <span class="role-title">{{ proj.name }} {% if proj.tech_stack %}| <em style="font-size: 8.8pt; font-weight: 500; color: #475569;">{{ proj.tech_stack | join(', ') }}</em>{% endif %}</span>
          {% if proj.github_url or proj.url %}<span class="entry-date"><a href="{{ proj.github_url or proj.url }}" style="color: #1e3a8a; text-decoration: none;">Reference</a></span>{% endif %}
        </div>
        {% if proj.highlights %}
        <ul>
          {% for hl in proj.highlights %}
          <li>{{ hl }}</li>
          {% endfor %}
        </ul>
        {% elif proj.description %}
        <p class="value-prop" style="margin-left: 13pt;">{{ proj.description }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Education & Credentials -->
    {% if profile.education %}
    <section>
      <div class="section-title">Education & Credentials</div>
      {% for edu in profile.education %}
      <div class="entry">
        <div class="entry-header">
          <span class="role-title">{{ edu.institution }}</span>
          <span class="entry-date">{% if edu.start_date and edu.end_date %}{{ edu.start_date }} - {{ edu.end_date }}{% elif edu.end_date %}{{ edu.end_date }}{% endif %}</span>
        </div>
        <div class="entry-header">
          <span style="font-weight: 500; color: #334155;">{{ edu.degree }}{% if edu.field_of_study %} in {{ edu.field_of_study }}{% endif %}</span>
          {% if edu.grade %}<span class="entry-loc">Honours: {{ edu.grade }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </section>
    {% endif %}

  </div>
</body>
</html>
