<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ profile.full_name }} - Resume</title>
  <style>
    @page {
      size: A4;
      margin: 12mm 15mm 12mm 15mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: "Times New Roman", Times, "Cambria", Georgia, serif;
      font-size: 10.5pt;
      line-height: 1.35;
      color: #111111;
      background: #ffffff;
      padding: 0;
    }
    .container {
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
    }
    /* Header */
    .header {
      text-align: center;
      margin-bottom: 10pt;
    }
    .header h1 {
      font-size: 19pt;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 3pt;
    }
    .header .contact-line {
      font-size: 9.5pt;
      color: #333333;
    }
    .header .contact-line a {
      color: #111111;
      text-decoration: none;
    }
    /* Section Headings */
    .section-title {
      font-size: 11pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      border-bottom: 1px solid #111111;
      padding-bottom: 1pt;
      margin-top: 8pt;
      margin-bottom: 4pt;
    }
    /* Entry Row */
    .entry {
      margin-bottom: 6pt;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 10.5pt;
    }
    .entry-title {
      font-weight: 700;
    }
    .entry-subtitle {
      font-style: italic;
    }
    .entry-date, .entry-location {
      font-size: 9.5pt;
      color: #333333;
      text-align: right;
    }
    /* Bullets */
    ul {
      margin-left: 14pt;
      margin-top: 2pt;
      margin-bottom: 4pt;
    }
    li {
      margin-bottom: 1.5pt;
      text-align: justify;
    }
    li strong {
      font-weight: 600;
    }
    /* Skills */
    .skills-line {
      margin-bottom: 2pt;
      font-size: 10pt;
    }
    .skills-line strong {
      font-weight: 700;
    }
    @media print {
      body {
        width: 100%;
      }
      .no-print {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <h1>{{ profile.full_name }}</h1>
      <div class="contact-line">
        {% if profile.location %}{{ profile.location }} | {% endif %}
        {% if profile.email %}<a href="mailto:{{ profile.email }}">{{ profile.email }}</a> | {% endif %}
        {% if profile.phone %}{{ profile.phone }} | {% endif %}
        {% if profile.linkedin_url %}<a href="{{ profile.linkedin_url }}">LinkedIn</a> | {% endif %}
        {% if profile.github_url %}<a href="{{ profile.github_url }}">GitHub</a> | {% endif %}
        {% if profile.portfolio_url %}<a href="{{ profile.portfolio_url }}">Portfolio</a>{% endif %}
      </div>
    </header>

    <!-- Education -->
    {% if profile.education %}
    <section>
      <div class="section-title">Education</div>
      {% for edu in profile.education %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ edu.institution }}</span>
          <span class="entry-date">{{ edu.start_date }}{% if edu.end_date %} -- {{ edu.end_date }}{% endif %}</span>
        </div>
        <div class="entry-header">
          <span class="entry-subtitle">{{ edu.degree }}{% if edu.field_of_study %} in {{ edu.field_of_study }}{% endif %}</span>
          {% if edu.grade %}<span class="entry-location">Grade: {{ edu.grade }}</span>{% endif %}
        </div>
        {% if edu.coursework %}
        <div style="font-size: 9.5pt; margin-top: 1pt;">
          <strong>Relevant Coursework:</strong> {{ edu.coursework | join(', ') }}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Experience -->
    {% if app.tailored_experiences %}
    <section>
      <div class="section-title">Experience</div>
      {% for exp in app.tailored_experiences %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ exp.role }}</span>
          <span class="entry-date">{{ exp.start_date }} -- {{ exp.end_date }}</span>
        </div>
        <div class="entry-header">
          <span class="entry-subtitle">{{ exp.company }}</span>
          {% if exp.location %}<span class="entry-location">{{ exp.location }}</span>{% endif %}
        </div>
        {% if exp.bullets %}
        <ul>
          {% for bullet in exp.bullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Projects -->
    {% if app.tailored_projects %}
    <section>
      <div class="section-title">Projects</div>
      {% for proj in app.tailored_projects %}
      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">{{ proj.name }} {% if proj.tech_stack %}| <em>{{ proj.tech_stack | join(', ') }}</em>{% endif %}</span>
          {% if proj.github_url %}<span class="entry-date"><a href="{{ proj.github_url }}">Link</a></span>{% endif %}
        </div>
        {% if proj.highlights %}
        <ul>
          {% for hl in proj.highlights %}
          <li>{{ hl }}</li>
          {% endfor %}
        </ul>
        {% elif proj.description %}
        <div style="font-size: 10pt; margin-left: 14pt; margin-top: 1pt;">
          {{ proj.description }}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endif %}

    <!-- Technical Skills -->
    {% if profile.skills %}
    <section>
      <div class="section-title">Technical Skills</div>
      {% for sk in profile.skills %}
      <div class="skills-line">
        <strong>{{ sk.category }}:</strong> {{ sk.skills | join(', ') }}
      </div>
      {% endfor %}
    </section>
    {% endif %}

  </div>
</body>
</html>
