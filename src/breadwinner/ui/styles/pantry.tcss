/* Breadwinner Pantry View Styling - Scoped to #pantry-view / #tab-profile */
#pantry-ide-split {
    height: 1fr;
}
#pantry-ide-nav {
    width: 32;
    height: 100%;
    padding: 0 1;
    background: #16161E;
    border-right: solid #2A2E3D;
}
.pantry-nav-btn {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    background: #212330;
    color: #C5C8C6;
    border: none;
    text-align: left;
}
.pantry-nav-btn:hover {
    background: #2A2E3D;
    color: #FFB86C;
}
.pantry-nav-sec-label {
    text-style: bold;
    color: #A89F91;
    margin-top: 1;
    margin-bottom: 0;
}
#pantry-snapshots-summary {
    height: auto;
    max-height: 2;
    margin-bottom: 1;
    color: #50FA7B;
    overflow: hidden;
}
#pantry-ide-main {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    background: #12131A;
}
#pantry-editor-header {
    height: 3;
    padding: 0 1;
    background: #16161E;
    border-bottom: solid #2A2E3D;
    align: left middle;
}
#pantry-editor-filename {
    width: auto;
    max-width: 32;
    height: 1;
    text-style: bold;
    color: #FFFFFF;
    margin-right: 1;
}
#pantry-editor-status {
    width: 1fr;
    height: 1;
    text-align: center;
    color: #50FA7B;
}
#btn-pantry-save {
    width: auto;
    min-width: 18;
    height: 1;
    padding: 0 1;
    border: none;
    background: #2A3D30;
    color: #50FA7B;
    text-style: bold;
}
#btn-pantry-save:hover {
    background: #3B5442;
    color: #FFFFFF;
}
#pantry-editor-textarea {
    height: 1fr;
    background: #0C0E14;
    border: round #2A2E3D;
    color: #F8F8F2;
}
#profile-md {
    display: none;
}
#pantry-ai-bar {
    height: auto;
    padding: 0;
    margin-top: 1;
    background: transparent;
    border: none;
    align: left middle;
}
#pantry-prompt-box {
    width: 1fr;
    height: 3;
    layout: horizontal;
    background: #0C0E14;
    border: round #2A2E3D;
    align: left middle;
}
#pantry-prompt-box:focus-within {
    border: round #FFB86C;
}
#pantry-ai-prompt {
    width: 1fr;
    height: 1;
    border: none;
    background: transparent;
    color: #F8F8F2;
    padding: 0 1;
}
#btn-pantry-ai-refine {
    width: auto;
    min-width: 16;
    height: 1;
    border: none;
    background: #D18F52;
    color: #141724;
    text-style: bold;
    padding: 0 1;
    margin-right: 1;
}
#btn-pantry-ai-refine:hover {
    background: #FFB86C;
    color: #0C0E14;
}
#pantry-maturity-widget {
    display: none;
}
