# ==============================================================================
# BREADWINNER ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your preferences.
# ==============================================================================

# LLM Provider Selection
# Options: "gemini", "deepseek", "lmstudio", "groq", "ollama", "openai"
BREADWINNER_LLM_PROVIDER=gemini

# DeepSeek (Reasoning & Code: deepseek-chat, deepseek-reasoner)
# Get your API key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini (Gemini 2.5 Flash, 1.5 Flash, 1.5 Pro)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LM Studio (Local LLM Server on Apple Silicon / PC)
# Start LM Studio Local Server (default: http://localhost:1234/v1)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Groq Cloud (High-speed Llama 3.3, Qwen 2.5)
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Local LLM Server)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2


# Candidate Source of Truth Portfolio
# Supported sources:
# 1. Astro / Keystatic portfolio directory (containing pages/about.astro or src/content)
# 2. Generic markdown directory (containing experience.md, skills.md, etc.)
# 3. Path to a resume.json (JSON Resume format)
PORTFOLIO_PATH=/path/to/your/portfolio

# Narrative Persona Defaults
# Built-in options: "tech_ai", "bridging_admin", "hospitality"
DEFAULT_PERSONA=tech_ai

# Resume Template Defaults
# Built-in options: "jakes" (r/EngineeringResumes single-column gold standard), "modern", "minimal", "ats"
DEFAULT_TEMPLATE=jakes

# Storage & Output
APPLICATIONS_DIR=./applications
DATABASE_PATH=./tracker.db
CSV_TRACKER_PATH=./job_tracker.csv

# PDF Generation (Headless Chromium / Chrome)
# Leave empty to auto-detect Chrome, Brave, Edge, or Chromium
BROWSER_PATH=
AUTO_GENERATE_PDF=true

